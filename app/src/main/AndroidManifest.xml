<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_phone_ledger"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_phone_ledger"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhoneLedger"
        android:usesCleartextTraffic="false">

        <service
            android:name=".autofill.PhoneLedgerAutofillService"
            android:exported="true"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <activity
            android:name=".autofill.NumberPickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PhoneLedger.Dialog" />

        <activity
            android:name=".autofill.AutofillFillActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.PhoneLedger.Transparent" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
